#!/bin/bash
# Native launcher: Python is only the local data/court-service layer.  The UI
# is WKWebView via native AppKit -- neither Chrome nor any browser is used.
BASE="http://127.0.0.1:8765"
DIR="$(cd "$(dirname "$0")/../Resources" && pwd)"
PY="$(command -v python3 || echo /usr/bin/python3)"
BUNDLE_VER="$(sed -n 's/^VERSION *= *"\([^"]*\)".*/\1/p' "$DIR/app.py" | head -1)"

if ! "$PY" -c 'import http.server' >/dev/null 2>&1; then
  osascript -e 'display alert "Python 3 needed" message "Open Terminal and run:  xcode-select --install  then re-open this app."'
  exit 1
fi

# If a server is already running, decide whether to reuse or replace it.
if curl -s -o /dev/null --max-time 2 "$BASE/api/health"; then
  RUN_VER="$(curl -s --max-time 2 "$BASE/api/version" | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p')"
  if [ -z "$RUN_VER" ] || [ "$RUN_VER" != "$BUNDLE_VER" ]; then
    # stale/older server: stop it so this (newer) instance can take over
    curl -s -o /dev/null --max-time 3 -X POST "$BASE/api/quit" || true
    for i in $(seq 1 25); do curl -s -o /dev/null --max-time 1 "$BASE/api/health" || break; sleep 0.3; done
  fi
fi

# Keep the local service alive between window closes.  It scans causelists in
# the background; launching the app again simply opens another native window.
if ! curl -s -o /dev/null --max-time 1 "$BASE/api/health"; then
  "$PY" "$DIR/app.py" --serve >/dev/null 2>&1 &
  for i in $(seq 1 30); do
    curl -s -o /dev/null --max-time 1 "$BASE/api/health" && break
    sleep 0.2
  done
fi

exec "$(dirname "$0")/webkit-window" "$BASE/"
